{
  "info": {
    "name": "Интернет-магазин (СӨЖ №1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Товары",
      "item": [
        {
          "name": "Список товаров  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Фильтр: категория + поиск  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?category=1&search=Смарт"
          }
        },
        {
          "name": "Один товар  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/1"
          }
        },
        {
          "name": "Товар в XML  [200 XML]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/1/xml"
          }
        },
        {
          "name": "Добавить товар  [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Мышка\",\n  \"description\": \"Беспроводная\",\n  \"price\": 7000,\n  \"stock\": 10,\n  \"sku\": \"EL-100\",\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Изменить товар  [200]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products/7",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Мышка 2\",\n  \"price\": 7500,\n  \"stock\": 8,\n  \"sku\": \"EL-100\",\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Загрузить фото (form-data, поле photo)  [200]",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/products/1/photo",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Удалить товар  [204]",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/7"
          }
        }
      ]
    },
    {
      "name": "Категории и клиенты",
      "item": [
        {
          "name": "Категории  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Добавить категорию  [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Спорт\",\n  \"description\": \"Спортивные товары\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Клиенты (с картой лояльности 1:1)  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Добавить клиента  [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Дана Ким\",\n  \"email\": \"dana@mail.kz\",\n  \"phone\": \"+77010000000\",\n  \"address\": \"Алматы\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Заказы",
      "item": [
        {
          "name": "Создать заказ  [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 3\n    },\n    {\n      \"productId\": 4,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Заказ с составом  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/1"
          }
        },
        {
          "name": "Все заказы  [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Статус: paid  [200]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Ошибки (валидация)",
      "item": [
        {
          "name": "Нет обязательных полей  [400]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": \"abc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Отрицательная цена  [400]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"sku\": \"X1\",\n  \"price\": -5,\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Дубликат sku  [409]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"sku\": \"EL-001\",\n  \"price\": 5,\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Товар не найден  [404]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/999"
          }
        },
        {
          "name": "Неверный JSON  [400 (в Body отправьте {bad)]",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Заказ: пустой items  [400]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Заказ: товара не хватает  [422]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 3,\n      \"quantity\": 99\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Заказ: клиент не найден  [404]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 99,\n  \"items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Недопустимый переход статуса  [422 (для заказа в статусе new)]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Фото неверного формата  [400 (приложите .txt)]",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/products/1/photo"
          }
        }
      ]
    }
  ]
}